<Window x:Class="PokeHub.App.Views.TrainerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PokeHub.App.ViewModels"
        xmlns:views="clr-namespace:PokeHub.App.Views"
        xmlns:loc="clr-namespace:PokeHub.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:TrainerEditorViewModel}"
        Title="{loc:T tr.title}" Width="1150" Height="720" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterOwner" FontSize="13" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource BgBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- lista -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="{Binding GameLabel}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
            <TextBox DockPanel.Dock="Top" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                     ToolTip="{loc:T tr.filterTip}" />
            <Image DockPanel.Dock="Bottom" Source="{Binding Sprite}" Width="160" Height="160" Margin="0,8,0,0" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" ToolTip="{loc:T tr.spriteTip}" />
            <ListBox ItemsSource="{Binding FilteredTrainers}" SelectedItem="{Binding Selected}" DisplayMemberPath="Display"
                     VirtualizingPanel.IsVirtualizing="True" FontFamily="Consolas" />
        </DockPanel>

        <!-- detalhe -->
        <DockPanel Grid.Column="1">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T common.save}" Command="{Binding SaveCommand}" FontWeight="Bold" Padding="16,6" />
                    <Button Content="{loc:T common.close}" Click="Close_Click" Padding="16,6" />
                </StackPanel>
            </DockPanel>

            <Grid IsEnabled="{Binding Current, Converter={StaticResource NotNullToBool}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- treinador -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:T tr.name}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Grid.Row="0" Grid.Column="1" Margin="0,0,16,4" MaxLength="10" />
                    <TextBlock Text="{loc:T tr.class}" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <ComboBox ItemsSource="{Binding Classes}" SelectedIndex="{Binding TrainerClass}" Grid.Row="0" Grid.Column="3" Margin="0,0,0,4" />

                    <TextBlock Text="{loc:T tr.ai}" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <TextBox Text="{Binding AiFlagsHex, UpdateSourceTrigger=LostFocus}" Grid.Row="1" Grid.Column="1" Margin="0,0,16,4" />
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="3" Margin="0,0,0,4">
                        <CheckBox Content="{loc:T tr.double}" IsChecked="{Binding DoubleBattle}" Margin="0,0,16,0" />
                        <CheckBox Content="{loc:T tr.items}" IsChecked="{Binding HasItems}" Margin="0,0,16,0" />
                        <CheckBox Content="{loc:T tr.moves}" IsChecked="{Binding HasMoves}" />
                    </StackPanel>

                    <TextBlock Text="{loc:T tr.aiFlags}" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,2,8,4" />
                    <ItemsControl ItemsSource="{Binding AiFlags}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,4" ToolTip="{loc:T tr.aiFlagsTip}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSet}" Margin="0,2,14,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:T tr.trainerItems}" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <UniformGrid Rows="1" Columns="4" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3">
                        <ComboBox ItemsSource="{Binding Items}" SelectedIndex="{Binding Item1}" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{Binding Items}" SelectedIndex="{Binding Item2}" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{Binding Items}" SelectedIndex="{Binding Item3}" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{Binding Items}" SelectedIndex="{Binding Item4}" />
                    </UniformGrid>
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,0,0,4">
                    <TextBlock Text="{loc:T tr.party}" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="{loc:T tr.addPokemon}" Command="{Binding AddPokemonCommand}" HorizontalAlignment="Right" />
                </DockPanel>

                <!-- time -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Party}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6" Background="{DynamicResource PanelBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Sprite}" Width="72" Height="72" Margin="0,0,10,0" VerticalAlignment="Top"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        <StackPanel Grid.Column="1">
                                            <WrapPanel>
                                                <TextBlock Text="{loc:T tr.species}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <views:SpeciesPicker Catalog="{Binding Owner.Catalog}" SelectedSpecies="{Binding Species}" Width="190" Margin="0,0,12,4" />
                                                <TextBlock Text="{loc:T tr.form}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBox Text="{Binding Form}" Width="40" Margin="0,0,12,4" />
                                                <TextBlock Text="{loc:T tr.level}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <TextBox Text="{Binding Level}" Width="40" Margin="0,0,12,4" />
                                                <StackPanel Orientation="Horizontal">
<TextBlock Text="{loc:T tr.difficulty}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <Slider Maximum="255" Value="{Binding Difficulty}" TickFrequency="1" IsSnapToTickEnabled="True" Width="110" Margin="0,0,4,4" VerticalAlignment="Center" />
                                                <TextBox Text="{Binding Difficulty}" Width="40" Margin="0,0,4,4" />
                                                <TextBlock Text="{Binding IvText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,4" />
</StackPanel>
                                                <TextBlock Text="{loc:T tr.item}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                           Visibility="{Binding Owner.HasItems, Converter={StaticResource BoolToVis}}" />
                                                <Image Source="{Binding ItemIcon}" Width="24" Height="24" Margin="0,0,4,4" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       Visibility="{Binding Owner.HasItems, Converter={StaticResource BoolToVis}}" />
                                                <ComboBox ItemsSource="{Binding Owner.Items}" SelectedIndex="{Binding Item}" Width="150" Margin="0,0,12,4"
                                                          Visibility="{Binding Owner.HasItems, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{loc:T tr.ballSeal}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                           Visibility="{Binding Owner.HasBallSeal, Converter={StaticResource BoolToVis}}" />
                                                <TextBox Text="{Binding BallSeal}" Width="40" Margin="0,0,4,4"
                                                         Visibility="{Binding Owner.HasBallSeal, Converter={StaticResource BoolToVis}}" />
                                            </WrapPanel>
                                            <WrapPanel Visibility="{Binding Owner.HasMoves, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{loc:T tr.movesLabel}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                <ComboBox ItemsSource="{Binding Owner.Moves}" SelectedIndex="{Binding Move1}" Width="125" Margin="0,0,4,4" />
                                                <ComboBox ItemsSource="{Binding Owner.Moves}" SelectedIndex="{Binding Move2}" Width="125" Margin="0,0,4,4" />
                                                <ComboBox ItemsSource="{Binding Owner.Moves}" SelectedIndex="{Binding Move3}" Width="125" Margin="0,0,4,4" />
                                                <ComboBox ItemsSource="{Binding Owner.Moves}" SelectedIndex="{Binding Move4}" Width="125" Margin="0,0,4,4" />
                                            </WrapPanel>
                                            <WrapPanel>
                                                <CheckBox Content="{loc:T tr.forceMale}" IsChecked="{Binding ForceMale}" Margin="0,0,12,0" />
                                                <CheckBox Content="{loc:T tr.forceFemale}" IsChecked="{Binding ForceFemale}" Margin="0,0,12,0" />
                                                <CheckBox Content="{loc:T tr.ability1}" IsChecked="{Binding AbilitySlot1}" Margin="0,0,12,0" />
                                                <CheckBox Content="{loc:T tr.ability2}" IsChecked="{Binding AbilitySlot2}" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{loc:T tr.remove}" VerticalAlignment="Top" MinWidth="70"
                                                Command="{Binding Owner.RemovePokemonCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
