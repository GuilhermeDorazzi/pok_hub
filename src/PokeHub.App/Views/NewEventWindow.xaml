<Window x:Class="PokeHub.App.Views.NewEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PokeHub.App"
        xmlns:vm="clr-namespace:PokeHub.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:NewEventViewModel}"
        Title="{loc:T newev.title}" Width="1240" Height="780" MinWidth="980" MinHeight="560"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Window.Resources>
        <DataTemplate x:Key="ChoiceWithIcon" DataType="{x:Type vm:NewEventChoice}">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,-4,6,-4" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="LongListPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="{loc:T newev.step.map}" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBox DockPanel.Dock="Top" Text="{Binding MapFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="{loc:T newev.mapFilter}" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="{loc:T newev.createdList}" FontWeight="Bold" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding Created}" SelectedItem="{Binding SelectedCreated}" Height="150" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                <DockPanel Margin="0,6,0,0">
                    <Button Content="{loc:T newev.newNpc}" Command="{Binding NewNpcCommand}" Padding="10,3" />
                    <Button Content="{loc:T newev.remove}" Command="{Binding RemoveCommand}" IsEnabled="{Binding IsEditing}" Padding="10,3" HorizontalAlignment="Right" Margin="0" />
                </DockPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding Maps}" SelectedItem="{Binding SelectedMap}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </DockPanel>

        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="{loc:T newev.step.place}" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Position}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
            <CheckBox DockPanel.Dock="Top" Content="{loc:T newev.realMap}" ToolTip="{loc:T newev.realMap.tip}" IsChecked="{Binding ShowRealMap}" IsEnabled="{Binding RealMapAvailable}" Margin="0,0,0,6" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="LayoutCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="LayoutCanvas_Click" Cursor="Cross">
                    <Image x:Name="LayoutImageView" Source="{Binding LayoutImage}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Canvas>
            </ScrollViewer>
        </DockPanel>

        <ScrollViewer Grid.Column="2" Margin="10,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{loc:T newev.step.look}" FontWeight="Bold" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding Sprites}" SelectedItem="{Binding SelectedSprite}" Visibility="{Binding UsesSpriteList, Converter={StaticResource BoolToVis}}" Height="170" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Image}" Width="32" Height="32" ToolTip="{Binding Id}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="{loc:T newev.movement}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Movements}" SelectedItem="{Binding SelectedMovement}" />
                </DockPanel>
                <DockPanel Margin="0,0,0,6" Visibility="{Binding UsesRange, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:T newev.range}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding Range}" Width="50" HorizontalAlignment="Left" />
                </DockPanel>
                <DockPanel Margin="0,0,0,12" Visibility="{Binding UsesFacing, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:T newev.facing}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Facings}" SelectedItem="{Binding SelectedFacing}" />
                </DockPanel>

                <TextBlock Text="{loc:T newev.step.does}" FontWeight="Bold" Margin="0,0,0,6" />
                <RadioButton Content="{loc:T newev.talk}" IsChecked="{Binding IsTalk}" Margin="0,0,0,4" />
                <RadioButton Content="{loc:T newev.item}" IsChecked="{Binding IsItem}" Margin="0,0,0,4" />
                <RadioButton Content="{loc:T newev.pokemon}" IsChecked="{Binding IsPokemon}" Margin="0,0,0,4" />
                <RadioButton Content="{loc:T newev.trade}" IsChecked="{Binding IsTrade}" Margin="0,0,0,4" />
                <RadioButton Content="{loc:T newev.quest}" IsChecked="{Binding IsQuest}" Margin="0,0,0,4" />
                <RadioButton Content="{loc:T newev.sell}" IsChecked="{Binding IsSell}" Margin="0,0,0,4" />
                <RadioButton Content="{loc:T newev.trainer}" IsChecked="{Binding IsTrainer}" Margin="0,0,0,8" />

                <StackPanel Visibility="{Binding IsTalk, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:T newev.talkText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding TalkText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsItem, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:T newev.beforeText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding BeforeText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,8" />
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:T newev.itemName}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox DockPanel.Dock="Right" Text="{Binding Quantity}" Width="44" Margin="8,0,0,0" ToolTip="{loc:T newev.quantity}" />
                        <ComboBox ItemTemplate="{StaticResource ChoiceWithIcon}" ItemsPanel="{StaticResource LongListPanel}" TextSearch.TextPath="Label" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" />
                    </DockPanel>
                    <TextBlock Text="{loc:T newev.afterText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding AfterText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsPokemon, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,8">
                        <Image DockPanel.Dock="Right" Source="{Binding PokemonSprite}" Width="32" Height="32" Margin="8,0,0,0" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <TextBlock Text="{loc:T newev.species}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemTemplate="{StaticResource ChoiceWithIcon}" ItemsPanel="{StaticResource LongListPanel}" TextSearch.TextPath="Label" ItemsSource="{Binding Species}" SelectedItem="{Binding SelectedSpecies}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:T newev.level}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding Level}" Width="50" HorizontalAlignment="Left" />
                    </DockPanel>
                    <CheckBox Content="{loc:T newev.vanish}" IsChecked="{Binding Vanish}" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:T newev.noTeam}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:T newev.pokemonText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding PokemonText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="50" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsTrade, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding FreeTradeNote}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6" />
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{loc:T newev.trade.ask}" Width="70" VerticalAlignment="Center" />
                        <ComboBox ItemTemplate="{StaticResource ChoiceWithIcon}" ItemsPanel="{StaticResource LongListPanel}" TextSearch.TextPath="Label" ItemsSource="{Binding AllSpecies}" SelectedItem="{Binding AskSpecies}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{loc:T newev.trade.give}" Width="70" VerticalAlignment="Center" />
                        <ComboBox ItemTemplate="{StaticResource ChoiceWithIcon}" ItemsPanel="{StaticResource LongListPanel}" TextSearch.TextPath="Label" ItemsSource="{Binding AllSpecies}" SelectedItem="{Binding GiveSpecies}" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{loc:T newev.trade.nickname}" Width="70" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Nickname}" MaxLength="10" />
                    </DockPanel>
                    <TextBlock Text="{loc:T newev.trade.askText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding AskText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:T newev.trade.thanksText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding ThanksText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:T newev.trade.wrongText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding WrongText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="36" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:T newev.trade.declineText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DeclineText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="36" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsQuest, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:T newev.quest.asks}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <RadioButton Content="{loc:T newev.quest.askItem}" IsChecked="{Binding QuestAsksItem}" GroupName="QuestAsk" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,4" Visibility="{Binding QuestAsksItem, Converter={StaticResource BoolToVis}}">
                        <TextBox DockPanel.Dock="Right" Text="{Binding QuestAskQuantity}" Width="44" Margin="8,0,0,0" ToolTip="{loc:T newev.quantity}" />
                        <ComboBox ItemTemplate="{StaticResource ChoiceWithIcon}" ItemsPanel="{StaticResource LongListPanel}" TextSearch.TextPath="Label" ItemsSource="{Binding Items}" SelectedItem="{Binding QuestAskItem}" />
                    </DockPanel>
                    <CheckBox Content="{loc:T newev.quest.take}" IsChecked="{Binding QuestTakeItem}" Margin="0,0,0,6" Visibility="{Binding QuestAsksItem, Converter={StaticResource BoolToVis}}" />
                    <RadioButton Content="{loc:T newev.quest.askMon}" IsChecked="{Binding QuestAsksPokemon, Mode=OneWay}" GroupName="QuestAsk" Click="QuestAskMon_Click" Margin="0,0,0,4" />
                    <ComboBox ItemTemplate="{StaticResource ChoiceWithIcon}" ItemsPanel="{StaticResource LongListPanel}" TextSearch.TextPath="Label" ItemsSource="{Binding AllSpecies}" SelectedItem="{Binding QuestAskSpecies}" Margin="0,0,0,8" Visibility="{Binding QuestAsksPokemon, Converter={StaticResource BoolToVis}}" />
                    <RadioButton Content="{loc:T newev.quest.askNothing}" IsChecked="{Binding QuestAsksNothing}" GroupName="QuestAsk" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:T newev.quest.reward}" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <RadioButton Content="{loc:T newev.quest.rewardItem}" IsChecked="{Binding RewardIsItem}" GroupName="QuestReward" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,6" Visibility="{Binding RewardIsItem, Converter={StaticResource BoolToVis}}">
                        <TextBox DockPanel.Dock="Right" Text="{Binding RewardQuantity}" Width="44" Margin="8,0,0,0" ToolTip="{loc:T newev.quantity}" />
                        <ComboBox ItemTemplate="{StaticResource ChoiceWithIcon}" ItemsPanel="{StaticResource LongListPanel}" TextSearch.TextPath="Label" ItemsSource="{Binding Items}" SelectedItem="{Binding RewardItem}" />
                    </DockPanel>
                    <RadioButton Content="{loc:T newev.quest.rewardMon}" IsChecked="{Binding RewardIsPokemon}" GroupName="QuestReward" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,6" Visibility="{Binding RewardIsPokemon, Converter={StaticResource BoolToVis}}">
                        <TextBox DockPanel.Dock="Right" Text="{Binding RewardLevel}" Width="44" Margin="8,0,0,0" ToolTip="{loc:T newev.level}" />
                        <ComboBox ItemTemplate="{StaticResource ChoiceWithIcon}" ItemsPanel="{StaticResource LongListPanel}" TextSearch.TextPath="Label" ItemsSource="{Binding AllSpecies}" SelectedItem="{Binding RewardSpecies}" />
                    </DockPanel>
                    <RadioButton Content="{loc:T newev.quest.rewardMoney}" IsChecked="{Binding RewardIsMoney}" GroupName="QuestReward" Margin="0,0,0,4" />
                    <TextBox Text="{Binding RewardMoney}" Width="90" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="{Binding RewardIsMoney, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{loc:T newev.quest.askText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding QuestAskText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:T newev.quest.notYetText}" Margin="0,0,0,4" Visibility="{Binding QuestAsksSomething, Converter={StaticResource BoolToVis}}" />
                    <TextBox Text="{Binding QuestNotYetText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" Visibility="{Binding QuestAsksSomething, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{loc:T newev.quest.rewardText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding QuestRewardText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:T newev.quest.doneText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding QuestDoneText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:T newev.quest.fullText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding QuestFullText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="36" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsSell, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{loc:T newev.species}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemTemplate="{StaticResource ChoiceWithIcon}" ItemsPanel="{StaticResource LongListPanel}" TextSearch.TextPath="Label" ItemsSource="{Binding AllSpecies}" SelectedItem="{Binding SellSpecies}" />
                    </DockPanel>
                    <WrapPanel Margin="0,0,0,6">
                        <TextBlock Text="{loc:T newev.level}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding SellLevel}" Width="50" Margin="0,0,16,0" />
                        <TextBlock Text="{loc:T newev.sell.price}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding SellPrice}" Width="80" />
                    </WrapPanel>
                    <CheckBox Content="{loc:T newev.sell.once}" IsChecked="{Binding SellOnce}" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:T newev.sell.offerText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SellOfferText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:T newev.sell.thanksText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SellThanksText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:T newev.sell.noMoneyText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SellNoMoneyText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="36" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:T newev.trade.declineText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SellDeclineText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="36" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:T newev.quest.fullText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SellFullText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="36" Margin="0,0,0,6" />
                    <TextBlock Text="{loc:T newev.sell.soldOutText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding SellSoldOutText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="36" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsTrainer, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{loc:T newev.trainer.which}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Trainers}" SelectedItem="{Binding TrainerChoice}" TextSearch.TextPath="Label" Margin="0,0,0,6">
                        <ComboBox.ItemsPanel><StaticResource ResourceKey="LongListPanel" /></ComboBox.ItemsPanel>
                    </ComboBox>
                    <CheckBox Content="{loc:T newev.trainer.sighted}" IsChecked="{Binding TrainerSighted}" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,6" Visibility="{Binding TrainerSighted, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T newev.trainer.sight}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding TrainerSight}" Width="50" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBlock Text="{loc:T newev.trainer.sightedNote}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8" Visibility="{Binding TrainerSighted, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Visibility="{Binding UsesScriptTexts, Converter={StaticResource BoolToVis}}">
                        <CheckBox Content="{loc:T newev.trainer.vanish}" IsChecked="{Binding TrainerVanish}" Margin="0,0,0,6" />
                        <TextBlock Text="{loc:T newev.trainer.challengeText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TrainerChallengeText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                        <TextBlock Text="{loc:T newev.trainer.beatenText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TrainerBeatenText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                        <TextBlock Text="{loc:T newev.trainer.afterText}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding TrainerAfterText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{loc:T newev.trainer.rematch}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding RematchModes}" SelectedItem="{Binding RematchMode}" />
                        </DockPanel>
                        <StackPanel Visibility="{Binding UsesRematchText, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T newev.trainer.rematchTrainer}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding RematchTrainers}" SelectedItem="{Binding RematchTrainerChoice}" TextSearch.TextPath="Label" Margin="0,0,0,6">
                                <ComboBox.ItemsPanel><StaticResource ResourceKey="LongListPanel" /></ComboBox.ItemsPanel>
                            </ComboBox>
                            <TextBlock Text="{loc:T newev.trainer.rematchText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding TrainerRematchText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Expander Header="{loc:T newev.cond.title}" Margin="0,10,0,0" Visibility="{Binding UsesScriptTexts, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,6,0,0">
                        <CheckBox Content="{loc:T newev.cond.elite}" IsChecked="{Binding CondAfterElite}" Margin="0,0,0,6" />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{loc:T newev.cond.minBadges}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding CondMinBadges}" Width="44" HorizontalAlignment="Left" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{loc:T newev.cond.maxLevel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding CondMaxLevel}" Width="44" HorizontalAlignment="Left" ToolTip="{loc:T newev.cond.maxLevelTip}" />
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="{loc:T newev.cond.badge}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding Badges}" SelectedItem="{Binding CondBadge}" />
                        </DockPanel>
                        <TextBlock Text="{loc:T newev.cond.afterNpc}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding FinishedNpcs}" SelectedItem="{Binding CondAfterNpc}" Margin="0,0,0,6" />
                        <TextBlock Text="{loc:T newev.cond.text}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CondText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="46" />
                    </StackPanel>
                </Expander>

                <TextBlock Text="{loc:T newev.hint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{Binding SaveLabel}" Command="{Binding CreateCommand}" FontWeight="Bold" Padding="16,6" Margin="0,0,6,0" />
                <Button Content="{loc:T common.close}" Click="Close_Click" Padding="16,6" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
