<Window x:Class="PokeHub.App.Views.PokedexAreaEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PokeHub.App.ViewModels"
        xmlns:loc="clr-namespace:PokeHub.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PokedexAreaEditorViewModel}"
        Title="{loc:T dx.title}" Width="1240" Height="900" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterOwner" FontSize="13" Closing="Window_Closing">
    <Window.Resources>
        <DataTemplate x:Key="BlockTemplate" DataType="{x:Type vm:AreaBlockViewModel}">
            <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Margin="4" Padding="6" Background="#FAFAFA">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock FontWeight="Bold" VerticalAlignment="Center">
                            <Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{loc:T dx.all}" Command="{Binding SelectAllCommand}" MinWidth="50" Padding="6,1" />
                            <Button Content="{loc:T dx.none}" Command="{Binding ClearAllCommand}" MinWidth="60" Padding="6,1" Margin="0" />
                        </StackPanel>
                    </DockPanel>
                    <ListBox ItemsSource="{Binding Areas}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="{Binding GameLabel}" Foreground="Gray" DockPanel.Dock="Right" VerticalAlignment="Center" />
            <TextBlock Text="{loc:T dx.pokemon}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Species}" SelectedIndex="{Binding SelectedIndex}" Width="260" MaxDropDownHeight="400" />
            <CheckBox Content="{loc:T dx.orderByName}" IsChecked="{Binding OrderByName}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock Text="{Binding Status}" Foreground="Gray" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:T common.save}" Command="{Binding SaveCommand}" FontWeight="Bold" Padding="16,6" />
                <Button Content="{loc:T common.close}" Click="Close_Click" Padding="16,6" />
            </StackPanel>
        </DockPanel>

        <!-- Mapa da Pokédex lido da ROM: áreas do bloco escolhido em destaque; clique alterna -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="4,0,4,8" Background="#FAFAFA"
                Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="{loc:T dx.mapBlock}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedMapBlock}" Width="220" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock x:Name="HoverText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="160" />
                    <TextBlock Text="{loc:T dx.mapHint}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.LayoutTransform><ScaleTransform ScaleX="2" ScaleY="2" /></Grid.LayoutTransform>
                        <Image x:Name="MapImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Canvas x:Name="MapCanvas" Background="Transparent" MouseLeftButtonDown="MapCanvas_MouseDown" MouseMove="MapCanvas_MouseMove" MouseLeave="MapCanvas_MouseLeave" />
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="{Binding MapError}" Foreground="Firebrick" Margin="4,0,4,8"
                   Visibility="{Binding HasMap, Converter={StaticResource InverseBoolToVis}}" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{loc:T dx.normal}" FontWeight="Bold" Margin="4,0" />
            <ItemsControl Grid.Row="1" ItemsSource="{Binding NormalBlocks}" ItemTemplate="{StaticResource BlockTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock Grid.Row="2" Text="{loc:T dx.special}" FontWeight="Bold" Margin="4,8,4,0" />
            <ItemsControl Grid.Row="3" ItemsSource="{Binding SpecialBlocks}" ItemTemplate="{StaticResource BlockTemplate}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </DockPanel>
</Window>
