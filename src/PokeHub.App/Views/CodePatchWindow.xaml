<Window x:Class="PokeHub.App.Views.CodePatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PokeHub.App"
        xmlns:vm="clr-namespace:PokeHub.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:CodePatchViewModel}"
        Title="{loc:T inject.title}" Width="900" Height="620" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{loc:T inject.intro}" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10" />

        <DataGrid Grid.Row="1" ItemsSource="{Binding Patches}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{loc:T inject.enabled}" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- a coluna de checkbox do DataGrid pede dois cliques: um para selecionar a linha e outro para marcar -->
                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:T inject.name}" Binding="{Binding Name}" IsReadOnly="True" Width="170" />
                <DataGridTextColumn Header="{loc:T inject.description}" Binding="{Binding Description}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="{loc:T inject.hooks}" Binding="{Binding Hooks}" IsReadOnly="True" Width="70" />
                <DataGridTextColumn Header="{loc:T inject.applied}" Binding="{Binding Applied}" IsReadOnly="True" Width="190" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock Text="{loc:T inject.newName}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="180" Padding="4,2" VerticalContentAlignment="Center" />
            <Button Content="{loc:T inject.create}" Command="{Binding CreateCommand}" Padding="10,3" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{loc:T inject.openFolder}" Command="{Binding OpenFolderCommand}" Padding="10,3" />
            <Button DockPanel.Dock="Right" Content="{loc:T inject.reload}" Command="{Binding ReloadCommand}" Padding="10,3" Margin="0,0,6,0" />
        </DockPanel>

        <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,6" />

        <TextBox Grid.Row="4" Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" TextChanged="Output_TextChanged" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{loc:T inject.revert}" Command="{Binding RevertCommand}" Padding="12,4" Margin="0,0,6,0" />
            <Button Content="{loc:T inject.apply}" Command="{Binding ApplyCommand}" Padding="12,4" FontWeight="SemiBold" Margin="0,0,6,0" />
            <Button Content="{loc:T inject.close}" IsCancel="True" Click="Close_Click" Padding="12,4" />
        </StackPanel>
    </Grid>
</Window>
