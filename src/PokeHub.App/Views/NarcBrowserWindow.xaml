<Window x:Class="PokeHub.App.Views.NarcBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PokeHub.App"
        xmlns:vm="clr-namespace:PokeHub.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:NarcBrowserViewModel}"
        Title="{loc:T narc.title}" Width="1120" Height="720" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,8,0">
            <TextBox DockPanel.Dock="Top" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" Margin="0,0,0,6" ToolTip="{loc:T narc.filterTip}" />
            <ListBox ItemsSource="{Binding Narcs}" SelectedItem="{Binding SelectedNarc}" DisplayMemberPath="RelativePath" FontFamily="Consolas"
                     VirtualizingPanel.IsVirtualizing="True" />
        </DockPanel>

        <DockPanel Grid.Column="1" Margin="0,0,8,0">
            <CheckBox DockPanel.Dock="Top" Content="{loc:T narc.onlyGraphics}" IsChecked="{Binding OnlyGraphics}" Margin="0,4,0,8" />
            <ListBox ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Thumbnail}" Width="48" Height="48" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontFamily="Consolas" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#B8B8B8">
            <Image Source="{Binding Preview}" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="NearestNeighbor">
                <Image.LayoutTransform><ScaleTransform ScaleX="2" ScaleY="2" /></Image.LayoutTransform>
            </Image>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:T narc.extract}" Command="{Binding ExtractCommand}" Padding="12,4" Margin="0,0,6,0" ToolTip="{loc:T narc.extractTip}" />
                <Button Content="{loc:T narc.replace}" Command="{Binding ReplaceCommand}" Padding="12,4" ToolTip="{loc:T narc.replaceTip}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
