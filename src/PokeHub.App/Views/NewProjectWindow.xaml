<Window x:Class="PokeHub.App.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PokeHub.App"
        Title="{loc:T np.title}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock Text="{loc:T np.name}" FontWeight="SemiBold" />
        <TextBox x:Name="NameBox" Margin="0,4,0,12" />

        <TextBlock Text="{loc:T np.rom}" FontWeight="SemiBold" />
        <DockPanel Margin="0,4,0,4">
            <Button DockPanel.Dock="Right" Content="{loc:T np.browse}" Click="Browse_Click" Margin="6,0,0,0" />
            <TextBox x:Name="RomBox" IsReadOnly="True" />
        </DockPanel>
        <TextBlock x:Name="DetectedText" Foreground="Gray" Margin="0,0,0,12" Text="{loc:T np.selectHint}" TextWrapping="Wrap" />

        <TextBlock Text="{loc:T np.copyHint}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:T common.cancel}" IsCancel="True" />
            <Button x:Name="CreateButton" Content="{loc:T np.create}" IsDefault="True" Click="Create_Click" IsEnabled="False" Margin="6,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
