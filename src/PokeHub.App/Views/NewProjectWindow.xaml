<Window x:Class="PokeHub.App.Views.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo projeto" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <StackPanel Margin="16">
        <TextBlock Text="Nome do projeto" FontWeight="SemiBold" />
        <TextBox x:Name="NameBox" Margin="0,4,0,12" />

        <TextBlock Text="ROM base (.nds)" FontWeight="SemiBold" />
        <DockPanel Margin="0,4,0,4">
            <Button DockPanel.Dock="Right" Content="Procurar..." Click="Browse_Click" Margin="6,0,0,0" />
            <TextBox x:Name="RomBox" IsReadOnly="True" />
        </DockPanel>
        <TextBlock x:Name="DetectedText" Foreground="Gray" Margin="0,0,0,12" Text="Selecione o dump da sua ROM. O hub nunca baixa ROMs." TextWrapping="Wrap" />

        <TextBlock Text="A ROM é copiada para projects/&lt;nome&gt;/base.nds e nunca é alterada. As ferramentas trabalham em workspace/."
                   Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" />
            <Button x:Name="CreateButton" Content="Criar" IsDefault="True" Click="Create_Click" IsEnabled="False" Margin="6,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
