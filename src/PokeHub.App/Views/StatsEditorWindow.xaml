<Window x:Class="PokeHub.App.Views.StatsEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PokeHub.App"
        xmlns:vm="clr-namespace:PokeHub.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:StatsEditorViewModel}"
        Title="{loc:T stats.title}" Width="1040" Height="700" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner" FontSize="13" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource BgBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Padding" Value="4,2" /></Style>
        <Style TargetType="TextBlock" x:Key="Lbl"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,8,6" /></Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,10,0">
            <TextBox DockPanel.Dock="Top" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="{loc:T picker.search}" />
            <ListBox ItemsSource="{Binding Filtered}" SelectedItem="{Binding Selected}" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Sprite}" Width="32" Height="32" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding Current, Converter={StaticResource NotNullToBool}}">
            <StackPanel Margin="0,0,8,0">
                <DockPanel Margin="0,0,0,10">
                    <Image DockPanel.Dock="Left" Source="{Binding Sprite}" Width="96" Height="96" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Selected.Label}" FontSize="20" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{loc:T stats.types}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox ItemsSource="{Binding Types}" SelectedIndex="{Binding Type1}" Width="110" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding Types}" SelectedIndex="{Binding Type2}" Width="110" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <GroupBox Header="{loc:T stats.base}" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Stats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Value}" Margin="0,0,8,0" />
                                        <Slider Grid.Column="2" Maximum="255" Value="{Binding Value}" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,6,0,0" FontWeight="SemiBold">
                            <Run Text="{loc:T stats.total}" /><Run Text=": " /><Run Text="{Binding Total, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{loc:T stats.evs}" Padding="8" Margin="0,0,0,10">
                    <ItemsControl ItemsSource="{Binding Evs}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Text="{Binding Value}" Width="30" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <GroupBox Header="{loc:T stats.other}" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:T stats.ability1}" Style="{StaticResource Lbl}" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Abilities}" SelectedIndex="{Binding Ability1}" Margin="0,0,14,6" />
                        <TextBlock Grid.Column="2" Text="{loc:T stats.ability2}" Style="{StaticResource Lbl}" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding Abilities}" SelectedIndex="{Binding Ability2}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="1" Text="{loc:T stats.item1}" Style="{StaticResource Lbl}" />
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Items}" SelectedIndex="{Binding Item1}" Margin="0,0,14,6" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:T stats.item2}" Style="{StaticResource Lbl}" />
                        <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Items}" SelectedIndex="{Binding Item2}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="2" Text="{loc:T stats.catch}" Style="{StaticResource Lbl}" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CatchRate}" Margin="0,0,14,6" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{loc:T stats.exp}" Style="{StaticResource Lbl}" />
                        <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ExpYield}" Margin="0,0,0,6" />

                        <TextBlock Grid.Row="3" Text="{loc:T stats.friendship}" Style="{StaticResource Lbl}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Friendship}" Margin="0,0,14,6" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{loc:T stats.growth}" Style="{StaticResource Lbl}" />
                        <ComboBox Grid.Row="3" Grid.Column="3" ItemsSource="{Binding GrowthRates}" SelectedIndex="{Binding GrowthRate}" Margin="0,0,0,6" />
                    </Grid>
                </GroupBox>

                <WrapPanel Margin="8,10,0,0">
                    <TextBlock Text="{loc:T stats.genderRatio}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding GenderRatio}" Width="50" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding GenderText}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,20,0" />
                    <TextBlock Text="{loc:T stats.eggCycles}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding EggCycles}" Width="50" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:T common.save}" Command="{Binding SaveCommand}" FontWeight="Bold" Padding="16,6" Margin="0,0,6,0" />
                <Button Content="{loc:T common.close}" Click="Close_Click" Padding="16,6" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
