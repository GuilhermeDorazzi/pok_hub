<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ícones próprios do hub, desenhados em uma grade de 24x24 com formas simples. Nada aqui vem dos arquivos dos jogos. -->
    <SolidColorBrush x:Key="R" Color="#E5484D" />
    <SolidColorBrush x:Key="W" Color="#F4F4F5" />
    <SolidColorBrush x:Key="D" Color="#2B2F36" />
    <SolidColorBrush x:Key="G" Color="#F2C55C" />
    <SolidColorBrush x:Key="B" Color="#4F9BE8" />
    <SolidColorBrush x:Key="N" Color="#6CC56A" />
    <SolidColorBrush x:Key="P" Color="#A86BD8" />
    <SolidColorBrush x:Key="S" Color="#8A919C" />
    <Pen x:Key="PenD" Brush="{StaticResource D}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="PenW" Brush="{StaticResource W}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
    <Pen x:Key="PenG" Brush="{StaticResource G}" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />

    <!-- Limites fixos: o desenho ocupa sempre a mesma área, mesmo quando não chega até a borda -->
    <GeometryDrawing x:Key="Frame" Geometry="M0,0 H24 V24 H0 Z" Brush="Transparent" />

    <!-- Mapas e eventos: mapa dobrado com um marcador -->
