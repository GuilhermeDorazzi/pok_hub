                <GeometryDrawing Brush="{StaticResource R}" Geometry="M12,4 A4,4 0 0 1 16,8 C16,11 12,15 12,15 C12,15 8,11 8,8 A4,4 0 0 1 12,4 Z" />
                <GeometryDrawing Brush="{StaticResource W}" Geometry="M12,6.5 A1.5,1.5 0 1 1 11.99,6.5 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

