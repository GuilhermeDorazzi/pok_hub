<Window x:Class="PokeHub.App.Views.EncounterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PokeHub.App.ViewModels"
        xmlns:views="clr-namespace:PokeHub.App.Views"
        xmlns:loc="clr-namespace:PokeHub.App"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:EncounterEditorViewModel}"
        Title="{loc:T enc.title}" Width="1200" Height="760" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" FontSize="13" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource BgBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:EncounterRowViewModel}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                <views:SpeciesPicker Grid.Column="1" Catalog="{Binding DataContext.Catalog, RelativeSource={RelativeSource AncestorType=Window}}"
                                     SelectedSpecies="{Binding Species}" Margin="0,0,6,0" />
                <views:SpeciesPicker Grid.Column="2" Catalog="{Binding DataContext.Catalog, RelativeSource={RelativeSource AncestorType=Window}}"
                                     SelectedSpecies="{Binding Species2}" Margin="0,0,6,0"
                          Visibility="{Binding HasTimes, Converter={StaticResource BoolToVis}}" />
                <views:SpeciesPicker Grid.Column="3" Catalog="{Binding DataContext.Catalog, RelativeSource={RelativeSource AncestorType=Window}}"
                                     SelectedSpecies="{Binding Species3}" Margin="0,0,6,0"
                          Visibility="{Binding HasTimes, Converter={StaticResource BoolToVis}}" />
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <TextBlock Text="{loc:T enc.level}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding MinLevel}" Width="40" />
                    <TextBlock Text=" – " VerticalAlignment="Center" Visibility="{Binding HasMax, Converter={StaticResource BoolToVis}}" />
                    <TextBox Text="{Binding MaxLevel}" Width="40" Visibility="{Binding HasMax, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type vm:EncounterGroupViewModel}">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8" Background="{DynamicResource PanelBrush}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding HasRate, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T enc.rate}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Text="{Binding Rate}" Width="40" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Visibility="{Binding HasTimes, Converter={StaticResource BoolToVis}}" Margin="48,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="176" /><ColumnDefinition Width="176" /><ColumnDefinition Width="176" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{loc:T enc.morning}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        <TextBlock Grid.Column="1" Text="{loc:T enc.dayTime}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="{loc:T enc.nightTime}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock DockPanel.Dock="Top" Text="{Binding GameLabel}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" TextWrapping="Wrap" />
            <TextBox DockPanel.Dock="Top" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="{loc:T enc.filterTip}" />
            <ListBox x:Name="EntryList" ItemsSource="{Binding FilteredEntries}" SelectedItem="{Binding Selected}" FontFamily="Consolas"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EntryLabel}, ConverterParameter={x:Null}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T common.save}" Command="{Binding SaveCommand}" FontWeight="Bold" Padding="16,6" />
                    <Button Content="{loc:T common.close}" Click="Close_Click" Padding="16,6" />
                </StackPanel>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedLabel}" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
