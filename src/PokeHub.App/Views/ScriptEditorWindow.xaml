<Window x:Class="PokeHub.App.Views.ScriptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PokeHub.App"
        xmlns:vm="clr-namespace:PokeHub.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ScriptEditorViewModel}"
        Title="{loc:T scr.title}" Width="1240" Height="780" MinWidth="960" MinHeight="520"
        WindowStartupLocation="CenterOwner" FontSize="13" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,10,0">
            <TextBox DockPanel.Dock="Top" Text="{Binding FileFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="{loc:T scr.fileFilter}" />
            <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </DockPanel>

        <DataGrid Grid.Column="1" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal" EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:T scr.col.entry}" Binding="{Binding Entry}" Width="60" />
                <DataGridTextColumn Header="{loc:T scr.col.line}" Binding="{Binding Line}" Width="50" />
                <DataGridTextColumn Header="{loc:T scr.col.position}" Binding="{Binding Position}" Width="55" />
                <DataGridTextColumn Header="{loc:T scr.col.command}" Binding="{Binding Command}" Width="150" />
                <DataGridTextColumn Header="{loc:T scr.col.args}" Binding="{Binding Args}" Width="240">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{loc:T scr.col.note}" Binding="{Binding Note}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Column="2" Margin="10,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="{loc:T scr.addTitle}" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBox DockPanel.Dock="Top" Text="{Binding CommandFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" ToolTip="{loc:T scr.commandFilter}" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Inputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,4">
                                <DockPanel>
                                    <TextBlock Text="{Binding Type}" Width="90" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Meaning}" Visibility="{Binding HasMeaning, Converter={StaticResource BoolToVis}}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="90,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{loc:T scr.insert}" Command="{Binding InsertCommand}" Margin="0,4,0,6" />
                <Button Content="{loc:T scr.remove}" Command="{Binding RemoveCommand}" Margin="0,0,0,8" />
                <TextBlock Text="{loc:T scr.hint}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Commands}" SelectedItem="{Binding SelectedCommand}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:T common.save}" Command="{Binding SaveCommand}" FontWeight="Bold" Padding="16,6" Margin="0,0,6,0" />
                <Button Content="{loc:T common.close}" Click="Close_Click" Padding="16,6" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</Window>
