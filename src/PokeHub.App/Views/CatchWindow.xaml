<Window x:Class="PokeHub.App.Views.CatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PokeHub.App"
        Title="{loc:T catch.title}" Width="980" Height="640" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" FontWeight="Bold" Text="{Binding Summary}" />

        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <ComboBox DockPanel.Dock="Right" Width="240" Margin="8,0,0,0" ItemsSource="{Binding Filters}" SelectedIndex="{Binding Filter}" />
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="{loc:T catch.search}" />
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:T catch.col.species}" Width="170" Binding="{Binding Species}" />
                <DataGridTextColumn Header="{loc:T catch.col.status}" Width="190" Binding="{Binding StatusText}" />
                <DataGridTextColumn Header="{loc:T catch.col.where}" Width="*" Binding="{Binding Where}" />
                <DataGridTextColumn Header="{loc:T catch.col.note}" Width="*" Binding="{Binding Note}" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:T common.close}" IsCancel="True" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Text="{loc:T catch.note}" />
        </DockPanel>
    </Grid>
</Window>
