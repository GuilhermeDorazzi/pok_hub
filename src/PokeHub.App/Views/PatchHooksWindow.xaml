<Window x:Class="PokeHub.App.Views.PatchHooksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PokeHub.App"
        xmlns:vm="clr-namespace:PokeHub.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PatchHooksViewModel}"
        Title="{Binding Title}" Width="1040" Height="640" MinWidth="780" MinHeight="460"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Grid Margin="12" x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{loc:T hooks.intro}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" />
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{loc:T inject.description}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" />
        </DockPanel>

        <DockPanel Grid.Row="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                <TextBlock Text="{loc:T hooks.hooks}" FontWeight="Bold" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="{loc:T hooks.removeHook}" Command="{Binding RemoveHookCommand}" Padding="10,2" />
                <Button DockPanel.Dock="Right" Content="{loc:T hooks.addHook}" Command="{Binding AddHookCommand}" Padding="10,2" Margin="0,0,6,0" />
                <Button DockPanel.Dock="Right" Content="{loc:T hooks.readBytes}" Command="{Binding ReadBytesCommand}" Padding="10,2" Margin="0,0,6,0" FontWeight="SemiBold" />
            </DockPanel>
            <DataGrid ItemsSource="{Binding Hooks}" SelectedItem="{Binding SelectedHook}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:T hooks.target}" Binding="{Binding Target, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                    <DataGridTextColumn Header="{loc:T hooks.address}" Binding="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Width="110" FontFamily="Consolas" />
                    <DataGridTemplateColumn Header="{loc:T hooks.type}" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Types, ElementName=Root}" SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:T hooks.symbol}" Binding="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                    <DataGridTextColumn Header="{loc:T hooks.bytes}" Binding="{Binding Bytes, UpdateSourceTrigger=PropertyChanged}" Width="110" FontFamily="Consolas" />
                    <DataGridTemplateColumn Header="{loc:T hooks.mode}" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Modes, ElementName=Root}" SelectedItem="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:T hooks.expect}" Binding="{Binding Expect, UpdateSourceTrigger=PropertyChanged}" Width="210" FontFamily="Consolas" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,10,0,4" LastChildFill="False">
            <TextBlock Text="{loc:T hooks.symbols}" FontWeight="Bold" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Content="{loc:T hooks.removeSymbol}" Command="{Binding RemoveSymbolCommand}" Padding="10,2" />
            <Button DockPanel.Dock="Right" Content="{loc:T hooks.addSymbol}" Command="{Binding AddSymbolCommand}" Padding="10,2" Margin="0,0,6,0" />
        </DockPanel>
        <DataGrid Grid.Row="4" ItemsSource="{Binding Symbols}" SelectedItem="{Binding SelectedSymbol}" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:T hooks.name}" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridTextColumn Header="{loc:T hooks.value}" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="180" FontFamily="Consolas" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{loc:T common.save}" Command="{Binding SaveCommand}" FontWeight="Bold" Padding="16,4" Margin="0,0,6,0" />
                <Button Content="{loc:T common.close}" IsCancel="True" Padding="16,4" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
