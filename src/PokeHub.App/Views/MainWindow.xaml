<Window x:Class="PokeHub.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PokeHub.App.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="PokeHub" Height="720" Width="1100" MinHeight="500" MinWidth="800"
        FontSize="13" Background="#F4F4F6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <!-- Barra superior: projeto -->
        <Border Grid.Row="0" Background="#2B2D42" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="PokeHub" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0" />
                <TextBlock DockPanel.Dock="Left" Text="Projeto:" Foreground="#CCD" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox DockPanel.Dock="Left" Width="220" ItemsSource="{Binding Projects}" SelectedItem="{Binding CurrentProject}"
                          DisplayMemberPath="Name" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Left" Content="Novo projeto" Command="{Binding NewProjectCommand}" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Left" Content="Pasta do projeto" Command="{Binding OpenProjectFolderCommand}" />
                <Separator DockPanel.Dock="Left" Width="12" Background="Transparent" />
                <Button DockPanel.Dock="Left" Content="Extrair ROM" Command="{Binding ExtractRomCommand}" />
                <Button DockPanel.Dock="Left" Content="Empacotar" Command="{Binding PackRomCommand}" />
                <Button DockPanel.Dock="Left" Content="Empacotar e rodar" Command="{Binding PackAndRunCommand}" FontWeight="Bold" />
                <Separator DockPanel.Dock="Left" Width="12" Background="Transparent" />
                <Button DockPanel.Dock="Left" Content="Salvar versão" Command="{Binding SaveVersionCommand}" />
                <Button DockPanel.Dock="Left" Content="Versões" Command="{Binding ShowHistoryCommand}" />
                <Button DockPanel.Dock="Right" Content="Pasta do hub" Command="{Binding OpenRootFolderCommand}" />
                <Button DockPanel.Dock="Right" Content="Instalar Git" Command="{Binding InstallGitCommand}"
                        Visibility="{Binding GitMissing, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding GitStatus}" Foreground="#AAB" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding RootPath}" Foreground="#AAB" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Text="{Binding ProjectSummary}" Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Contextos -->
            <ListBox Grid.Column="0" ItemsSource="{Binding Contexts}" SelectedItem="{Binding SelectedContext}"
                     BorderThickness="0,0,1,0" Background="White" Padding="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="10,8">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Hint}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Ferramentas do contexto -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedContext.Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                    <TextBlock Text="Nenhuma ferramenta cadastrada para este contexto ainda." Foreground="Gray">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tools.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Tools}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusText}" Foreground="#555" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock Text="  ● em execução" Foreground="Green" VerticalAlignment="Center"
                                                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,4" />
                                            <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap">
                                                <Run Text="{Binding LicenseText, Mode=OneWay}" />
                                                <Run Text="   " />
                                                <Run Text="{Binding RequiresText, Mode=OneWay}">
                                                    <Run.Style>
                                                        <Style TargetType="Run">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasMissingDependency}" Value="True">
                                                                    <Setter Property="Foreground" Value="Firebrick" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Run.Style>
                                                </Run>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Notes}" Foreground="#8A6D00" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="12,0,0,0" MinWidth="150">
                                            <Button Content="Abrir" Command="{Binding LaunchCommand}" FontWeight="Bold" Margin="0,0,0,6"
                                                    Visibility="{Binding HasBuild, Converter={StaticResource InverseBoolToVis}}" />
                                            <Button Content="Compilar ROM" Command="{Binding BuildCommand}" FontWeight="Bold" Margin="0,0,0,6"
                                                    Visibility="{Binding HasBuild, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" Margin="0,0,0,6" />
                                            <Button Content="Pasta" Command="{Binding OpenFolderCommand}" Margin="0,0,0,6" />
                                            <Button Content="Site" Command="{Binding OpenHomepageCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="#CCC" />

        <!-- Log -->
        <DockPanel Grid.Row="3" Background="#1E1E1E">
            <DockPanel DockPanel.Dock="Top" Margin="8,4">
                <TextBlock Text="Log" Foreground="#AAA" FontWeight="Bold" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Limpar" Command="{Binding ClearLogCommand}" HorizontalAlignment="Right" MinWidth="60" Padding="6,2" />
            </DockPanel>
            <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Background="#1E1E1E" Foreground="#DDD" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Padding="8,0"
                     TextChanged="Log_TextChanged" />
        </DockPanel>
    </Grid>
</Window>
