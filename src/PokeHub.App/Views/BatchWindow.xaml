<Window x:Class="PokeHub.App.Views.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PokeHub.App"
        xmlns:vm="clr-namespace:PokeHub.App.ViewModels"
        xmlns:views="clr-namespace:PokeHub.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:BatchViewModel}"
        Title="{loc:T batch.title}" Width="980" Height="640" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="4,2" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="4,2" /></Style>
        <Style x:Key="Lbl" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,6,0" /></Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="{loc:T batch.intro}" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,10" />

                <GroupBox Padding="8" Margin="0,0,0,10">
                    <GroupBox.Header><CheckBox Content="{loc:T batch.trainers}" IsChecked="{Binding TrainersEnabled}" FontWeight="Bold" /></GroupBox.Header>
                    <StackPanel IsEnabled="{Binding TrainersEnabled}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T batch.class}" Style="{StaticResource Lbl}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}" DisplayMemberPath="Name" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:T batch.nameFilter}" Style="{StaticResource Lbl}" />
                            <TextBox Grid.Column="1" Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <TextBlock Text="{loc:T batch.levels}" FontWeight="SemiBold" Margin="0,6,0,4" />
                        <WrapPanel>
                            <TextBlock Text="{loc:T batch.percent}" Style="{StaticResource Lbl}" />
                            <TextBox Width="60" Text="{Binding TrainerLevelPercent}" Margin="0,0,12,4" />
                            <TextBlock Text="{loc:T batch.offset}" Style="{StaticResource Lbl}" />
                            <TextBox Width="50" Text="{Binding TrainerLevelOffset}" Margin="0,0,12,4" />
                            <TextBlock Text="{loc:T batch.min}" Style="{StaticResource Lbl}" />
                            <TextBox Width="44" Text="{Binding TrainerMinLevel}" Margin="0,0,12,4" />
                            <TextBlock Text="{loc:T batch.max}" Style="{StaticResource Lbl}" />
                            <TextBox Width="44" Text="{Binding TrainerMaxLevel}" Margin="0,0,0,4" />
                        </WrapPanel>
                        <CheckBox Content="{loc:T batch.heldItem}" IsChecked="{Binding SetHeldItem}" Margin="0,8,0,4" />
                        <ComboBox ItemsSource="{Binding Items}" SelectedItem="{Binding HeldItem}" DisplayMemberPath="Name" IsEnabled="{Binding SetHeldItem}" IsEditable="True" IsTextSearchEnabled="True" />
                        <CheckBox Content="{loc:T batch.replaceSpecies}" IsChecked="{Binding TrainerReplace}" Margin="0,8,0,4" />
                        <Grid IsEnabled="{Binding TrainerReplace}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <views:SpeciesPicker Catalog="{Binding Catalog}" SelectedSpecies="{Binding TrainerFrom}" HideEmpty="True" />
                            <TextBlock Grid.Column="1" Text="→" Margin="8,0" VerticalAlignment="Center" />
                            <views:SpeciesPicker Grid.Column="2" Catalog="{Binding Catalog}" SelectedSpecies="{Binding TrainerTo}" HideEmpty="True" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Padding="8">
                    <GroupBox.Header><CheckBox Content="{loc:T batch.encounters}" IsChecked="{Binding EncountersEnabled}" FontWeight="Bold" /></GroupBox.Header>
                    <StackPanel IsEnabled="{Binding EncountersEnabled}">
                        <CheckBox Content="{loc:T batch.replaceSpeciesAll}" IsChecked="{Binding EncounterReplace}" Margin="0,0,0,4" />
                        <Grid IsEnabled="{Binding EncounterReplace}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <views:SpeciesPicker Catalog="{Binding Catalog}" SelectedSpecies="{Binding EncounterFrom}" HideEmpty="True" />
                            <TextBlock Grid.Column="1" Text="→" Margin="8,0" VerticalAlignment="Center" />
                            <views:SpeciesPicker Grid.Column="2" Catalog="{Binding Catalog}" SelectedSpecies="{Binding EncounterTo}" HideEmpty="True" />
                        </Grid>
                        <TextBlock Text="{loc:T batch.levels}" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <WrapPanel>
                            <TextBlock Text="{loc:T batch.percent}" Style="{StaticResource Lbl}" />
                            <TextBox Width="60" Text="{Binding EncounterLevelPercent}" Margin="0,0,12,4" />
                            <TextBlock Text="{loc:T batch.offset}" Style="{StaticResource Lbl}" />
                            <TextBox Width="50" Text="{Binding EncounterLevelOffset}" Margin="0,0,12,4" />
                            <TextBlock Text="{loc:T batch.min}" Style="{StaticResource Lbl}" />
                            <TextBox Width="44" Text="{Binding EncounterMinLevel}" Margin="0,0,12,4" />
                            <TextBlock Text="{loc:T batch.max}" Style="{StaticResource Lbl}" />
                            <TextBox Width="44" Text="{Binding EncounterMaxLevel}" Margin="0,0,0,4" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Content="{loc:T batch.preview}" Command="{Binding BuildPreviewCommand}" FontWeight="Bold" Padding="14,4" />
                <TextBlock Text="{Binding Status}" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Preview}" FontFamily="Consolas" FontSize="12" />
            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="{loc:T batch.applyHint}" Foreground="Gray" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T batch.apply}" Command="{Binding ApplyCommand}" FontWeight="Bold" Padding="14,4" />
                    <Button Content="{loc:T common.close}" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
