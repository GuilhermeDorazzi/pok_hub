<Window x:Class="PokeHub.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Versões do workspace" Width="640" Height="440" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Cada versão é um commit do git em workspace/. Restaurar volta todos os arquivos para aquele estado; o estado atual é guardado antes como uma nova versão, então nada se perde." />

        <ListView x:Name="VersionsList" Grid.Row="1" SelectionMode="Single" SelectionChanged="VersionsList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Versão" Width="90" DisplayMemberBinding="{Binding Hash}" />
                    <GridViewColumn Header="Descrição" Width="500" DisplayMemberBinding="{Binding Message}" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="Gray" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RestoreButton" Content="Restaurar esta versão" Click="Restore_Click" IsEnabled="False" FontWeight="Bold" />
                <Button Content="Fechar" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
