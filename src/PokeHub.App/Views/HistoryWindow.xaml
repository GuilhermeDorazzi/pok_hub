<Window x:Class="PokeHub.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PokeHub.App"
        Title="{loc:T hist.title}" Width="640" Height="440" MinWidth="480" MinHeight="300"
        WindowStartupLocation="CenterOwner" FontSize="13">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Text="{loc:T hist.intro}" />

        <ListView x:Name="VersionsList" Grid.Row="1" SelectionMode="Single" SelectionChanged="VersionsList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{loc:T hist.colVersion}" Width="90" DisplayMemberBinding="{Binding Hash}" />
                    <GridViewColumn Header="{loc:T hist.colDesc}" Width="500" DisplayMemberBinding="{Binding Message}" />
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="Gray" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CompareButton" Content="{loc:T hist.whatChanged}" Click="Compare_Click" IsEnabled="False" />
                <Button x:Name="RestoreButton" Content="{loc:T hist.restore}" Click="Restore_Click" IsEnabled="False" FontWeight="Bold" />
                <Button Content="{loc:T common.close}" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
