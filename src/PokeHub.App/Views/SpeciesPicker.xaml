<UserControl x:Class="PokeHub.App.Views.SpeciesPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PokeHub.App">
    <Grid>
        <ToggleButton x:Name="Toggle" HorizontalContentAlignment="Stretch" Padding="4,1" ToolTip="{loc:T picker.tip}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="▾" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="Gray" />
                <Image x:Name="Thumb" Width="24" Height="24" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="Label" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </ToggleButton>
        <Popup x:Name="Drop" PlacementTarget="{Binding ElementName=Toggle}" Placement="Bottom" StaysOpen="False"
               IsOpen="{Binding IsChecked, ElementName=Toggle, Mode=TwoWay}" Opened="Drop_Opened" Closed="Drop_Closed">
            <Border Background="White" BorderBrush="#AAA" BorderThickness="1" Padding="6" Width="280">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox x:Name="Search" Padding="4,3" TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown" />
                        <TextBlock x:Name="SearchHint" Text="{loc:T picker.search}" Foreground="Gray" Margin="7,3,0,0" IsHitTestVisible="False" />
                    </Grid>
                    <ListBox x:Name="List" Height="320" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding Sprite}" Width="36" Height="36" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
